                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT p.project_id, p.department_id, p.start_date, p.end_date,
p.budget, MIN(e.employee_id) AS lead_employee_id,
SUM(e.salary) AS dept_salary_expenditure,
DATEDIFF(day, p.start_date, p.end_date) AS duration_days
FROM projects p
JOIN employees e ON e.department_id = p.department_id
GROUP BY p.project_id, p.department_id, p.start_date, p.end_date, p.budget</property>
                <property
