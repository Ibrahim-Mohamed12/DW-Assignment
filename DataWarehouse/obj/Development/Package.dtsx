                    <arrayElement
                      dataType="System.String"><![CDATA[#region Help:  Introduction to the Script Component
/* The Script Component allows you to perform virtually any operation that can be accomplished in
 * a .Net application within the context of an Integration Services data flow.
 *
 * Expand the other regions which have "Help" prefixes for examples of specific ways to use
 * Integration Services features within this script component. */
#endregion

#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
#endregion

/// <summary>
/// This is the class to which to add your code.  Do not change the name, attributes, or parent
/// of this class.
/// </summary>
[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    // ---------------------------------------------------------------
    // Fallback date range — used only when package variables are absent
    // or you prefer to hardcode the range directly here.
    // ---------------------------------------------------------------
    private static readonly DateTime FallbackStart = new DateTime(2015, 1, 1);
    private static readonly DateTime FallbackEnd = new DateTime(2035, 12, 31);
    public override void CreateNewOutputRows()
    {
        DateTime startDate = GetStartDate();
        DateTime endDate = GetEndDate();

        if (startDate > endDate)
            throw new InvalidOperationException(
                string.Format(
                    "DateRangeStart ({0:yyyy-MM-dd}) must be earlier than DateRangeEnd ({1:yyyy-MM-dd}).",
                    startDate, endDate));

        for (DateTime current = startDate; current <= endDate; current = current.AddDays(1))
        {
            Output0Buffer.AddRow();

            Output0Buffer.fulldate = current;
            Output0Buffer.dayofweek = GetIsoDayOfWeek(current);   // 1=Mon … 7=Sun
            Output0Buffer.dayofmonth = (sbyte)current.Day;
            Output0Buffer.monthnumber = (sbyte)current.Month;
            Output0Buffer.monthname = current.ToString("MMMM");   // "January" … "December"
            Output0Buffer.quarter = (sbyte)GetQuarter(current);
            Output0Buffer.year = (short)current.Year;
            Output0Buffer.isweekend = IsWeekend(current);
        }

        Output0Buffer.SetEndOfRowset();
    }

    // ---------------------------------------------------------------
    // Helper — ISO day-of-week: Monday=1, Tuesday=2 … Sunday=7
    // .NET's DayOfWeek enum has Sunday=0, so we remap it.
    // ---------------------------------------------------------------
    private static sbyte GetIsoDayOfWeek(DateTime date)
    {
        // DayOfWeek: Sun=0, Mon=1, Tue=2, Wed=3, Thu=4, Fri=5, Sat=6
        // ISO 8601:  Mon=1, Tue=2, Wed=3, Thu=4, Fri=5, Sat=6, Sun=7
        int dotNet = (int)date.DayOfWeek;   // 0–6
        return (sbyte)(dotNet == 0 ? 7 : dotNet);
    }

    // ---------------------------------------------------------------
    // Helper — calendar quarter (1–4)
    // ---------------------------------------------------------------
    private static int GetQuarter(DateTime date)
    {
        return (date.Month - 1) / 3 + 1;
    }

    // ---------------------------------------------------------------
    // Helper — weekend flag
    // ---------------------------------------------------------------
    private static bool IsWeekend(DateTime date)
    {
        return date.DayOfWeek == DayOfWeek.Saturday
            || date.DayOfWeek == DayOfWeek.Sunday;
    }

    // ---------------------------------------------------------------
    // Helper — read start date from package variable, fall back to const
    // ---------------------------------------------------------------
    private DateTime GetStartDate()
    {
        try
        {
            string raw = Variables.DateRangeStart.ToString().Trim();
            return DateTime.Parse(raw);
        }
        catch
        {
            return FallbackStart;
        }
    }

    // ---------------------------------------------------------------
    // Helper — read end date from package variable, fall back to const
    // ---------------------------------------------------------------
    private DateTime GetEndDate()
    {
        try
        {
            string raw = Variables.DateRangeEnd.ToString().Trim();
            return DateTime.Parse(raw);
        }
        catch
        {
            return FallbackEnd;
        }
    }

}
]]></arrayElement>
